{
  "name": "clonecamscanner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.18.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && vite build && node scripts/test-comparison-build.mjs",
    "fixtures:generate": "node scripts/generate-synthetic-fixtures.ts tests/fixtures",
    "fixtures:smartdoc-sample": "node scripts/prepare-smartdoc-sample.ts tests/datasets/smartdoc15-sample/sampleDataset tests/fixtures/smartdoc15",
    "benchmark:scanic-smartdoc": "node scripts/run-browser-benchmark.mjs http://127.0.0.1:5173/tests/browser/scanic-smartdoc-benchmark.html",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "heic-to": "1.6.6",
    "onnxruntime-web": "1.27.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "scanic": "1.6.0",
    "scanic-ml": "0.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
